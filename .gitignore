# Local .terraform directories
.terraform/

# .tfstate and lock files
*.tfstate
*.tfstate.*
*.terraform.lock.hcl


# Crash log files
crash.log
crash.*.log

# Exclude all .tfvars files, which are likely to contain sensitive data, such as
# password, private keys, and other secrets. These should not be part of version
# control as they are data points which are potentially sensitive and subject
# to change depending on the environment.
*.tfvars
*.tfvars.json

# Ignore override files as they are usually used to override resources locally and so
# are not checked in
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Ignore transient lock info files created by terraform apply
.terraform.tfstate.lock.info

# Include override files you do wish to add to version control using negated pattern
# !example_override.tf

# Plan output of `terraform/tofu plan -out=tfplan`. Binary, and it embeds the
# resolved values of every variable — including anything sensitive.
tfplan
*tfplan*

# Ignore CLI configuration files
.terraformrc
terraform.rc

# Optional: ignore graph output files generated by `terraform graph`
# *.dot

# Optional: ignore plan files saved before destroying Terraform configuration
# Uncomment the line below if you want to ignore planout files.
# planout


# ---------------------------------------------------------------------------
# Demo instances
#
# bootstrap-terraform.sh renders one self-contained demo per run into
# demos/<name>/. The folder itself is NOT ignored: commit one when you want a
# record of exactly what a given demo was, leave it alone otherwise.
#
# What is never committed, whatever you decide about the folder:
#   - local state, which is machine-specific and can contain resource detail
#   - .envconfig, which carries the operator's own account
#
# terraform.tfvars IS committable inside a demo, because the parameters are the
# interesting part of the record and hold no credentials. The edge secret and
# the Cloudflare token come from the environment, never from a file.
#
# Note that a committed demo folder is a record, not a working handle: without
# the state file nobody else can apply or destroy it.
# ---------------------------------------------------------------------------
demos/**/.terraform/
demos/**/*.tfstate
demos/**/*.tfstate.*
demos/**/tfplan
demos/**/.envconfig
!demos/**/terraform.tfvars

# Older naming, kept so existing working copies stay clean.
envs/
.labconfig
.envconfig

# Generated notification emails (contain internal distribution lists)
*-created.eml
lab-created.eml
env-created.eml

# Cloudflare credentials. The API token is read from the environment
# (CLOUDFLARE_API_TOKEN), never from a file in the tree.
.cloudflare
cloudflare.auto.tfvars
cloudflare.auto.tfvars.json

