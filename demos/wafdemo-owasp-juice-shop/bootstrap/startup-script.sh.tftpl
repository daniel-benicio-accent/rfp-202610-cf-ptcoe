#!/usr/bin/env bash
# =============================================================================
# Juice Shop origin bootstrap
#
# Rendered by Terraform (templatefile) into the VM's startup-script metadata.
# Template placeholders use the dollar-brace form, so bash variables in this
# file are written brace-free ($VAR, never the braced form) to keep the two
# apart.
#
# GCE runs startup scripts on EVERY boot, not only the first, so this is
# idempotent:
#   - packages and the origin certificate: once, guarded by marker files
#   - containers: removed and recreated every boot, which also picks up a
#     newer image when the tag is a moving one such as :latest
#
# Logs:          sudo journalctl -u google-startup-scripts.service
# Re-run by hand: sudo google_metadata_script_runner startup
# =============================================================================
set -euo pipefail

JUICE_SHOP_IMAGE="${juice_shop_image}"
PROXY_IMAGE="${proxy_image}"
PUBLIC_HOSTNAME="${hostname}"

STATE_DIR=/var/lib/wafdemo
CONF_DIR=/etc/wafdemo

log() { echo "[wafdemo-bootstrap] $*"; }

# Ubuntu cloud images run unattended-upgrades on first boot and hold the dpkg
# lock while doing it. Without the lock timeout apt fails straight away with
# "Could not get lock /var/lib/dpkg/lock-frontend".
apt_get() {
  DEBIAN_FRONTEND=noninteractive apt-get -q -y \
    -o DPkg::Lock::Timeout=600 \
    -o Dpkg::Options::=--force-confdef \
    -o Dpkg::Options::=--force-confold \
    "$@"
}

mkdir -p "$STATE_DIR" "$CONF_DIR/tls"

# ── 1. Packages (first boot only) ────────────────────────────────────────────
if [ ! -f "$STATE_DIR/packages.done" ]; then
  log "Updating the package index and upgrading the base image"
  apt_get update
  apt_get full-upgrade
  log "Installing Podman and dependencies"
  apt_get install podman openssl curl ca-certificates
  apt_get autoremove
  touch "$STATE_DIR/packages.done"

  # Usually a new kernel. Rebooting now means the demo runs on a patched
  # kernel; the marker above stops the upgrade repeating on the next boot.
  if [ -f /var/run/reboot-required ]; then
    log "Upgrade requires a reboot. Rebooting; this script resumes on the next boot."
    systemctl reboot
    exit 0
  fi
fi

log "$(podman --version)"

# ── 2. Origin certificate (first boot only) ──────────────────────────────────
# Self-signed, so Cloudflare can run in "full" mode and the edge-to-origin leg
# is encrypted. It is not validated — "strict" with a Cloudflare Origin CA
# certificate is the production answer, and the demo narrative should say so.
if [ ! -f "$CONF_DIR/tls/origin.key" ]; then
  log "Generating a self-signed origin certificate for $PUBLIC_HOSTNAME"
  openssl req -x509 -nodes -newkey rsa:2048 -days 825 \
    -subj "/CN=$PUBLIC_HOSTNAME" \
    -addext "subjectAltName=DNS:$PUBLIC_HOSTNAME" \
    -keyout "$CONF_DIR/tls/origin.key" \
    -out "$CONF_DIR/tls/origin.crt"
  chmod 600 "$CONF_DIR/tls/origin.key"
fi

# ── 3. Reverse proxy configuration ───────────────────────────────────────────
# Juice Shop only speaks plain HTTP on 3000, and Cloudflare cannot proxy to
# port 3000 at all. nginx publishes it on 80 and 443 instead.
#
# The heredoc delimiter is quoted, so bash leaves nginx's $variables alone.
# The server_name below is filled in by Terraform before bash ever runs.
cat > "$CONF_DIR/nginx.conf" <<'NGINX'
map $http_upgrade $connection_upgrade {
  default upgrade;
  ''      close;
}

# Plain HTTP for the public hostname: send the visitor to HTTPS.
server {
  listen 80;
  server_name ${hostname};
  return 301 https://$host$request_uri;
}

# Everything else: HTTPS from Cloudflare, and plain HTTP by IP during setup.
server {
  listen 80  default_server;
  listen 443 ssl default_server;
  server_name _;

  ssl_certificate     /etc/nginx/tls/origin.crt;
  ssl_certificate_key /etc/nginx/tls/origin.key;

  location / {
    proxy_pass         http://127.0.0.1:3000;
    proxy_http_version 1.1;
    proxy_set_header   Host              $host;
    proxy_set_header   X-Real-IP         $remote_addr;
    proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
    proxy_set_header   X-Forwarded-Proto $scheme;
    # Juice Shop pushes notifications over a websocket.
    proxy_set_header   Upgrade           $http_upgrade;
    proxy_set_header   Connection        $connection_upgrade;
  }
}
NGINX

# ── 4. Containers ────────────────────────────────────────────────────────────
pull() {
  for attempt in 1 2 3 4 5; do
    if podman pull --quiet "$1" >/dev/null; then
      return 0
    fi
    log "Pull of $1 failed (attempt $attempt of 5); retrying in 20s"
    sleep 20
  done
  log "Giving up on $1"
  return 1
}

pull "$JUICE_SHOP_IMAGE"
pull "$PROXY_IMAGE"

log "Recreating containers"
podman rm --force --ignore juice-shop-proxy juice-shop-app >/dev/null

# Host networking on purpose: it avoids Podman's pod pause image and network
# DNS plugins, both of which vary between Ubuntu releases. Juice Shop's own
# port 3000 is therefore bound on the host, but the VPC firewall only admits
# 22 (from IAP), 80 and 443, so it is not reachable from outside.
podman run --detach --name juice-shop-app --network host --restart always \
  "$JUICE_SHOP_IMAGE"

podman run --detach --name juice-shop-proxy --network host --restart always \
  --volume "$CONF_DIR/nginx.conf:/etc/nginx/conf.d/default.conf:ro" \
  --volume "$CONF_DIR/tls:/etc/nginx/tls:ro" \
  "$PROXY_IMAGE"

# ── 5. Health check ──────────────────────────────────────────────────────────
# Juice Shop seeds its database on start, which takes a minute or two on a
# small VM. nginx answers 502 until then, which curl -f treats as a failure.
log "Waiting for Juice Shop to answer through nginx"
for attempt in $(seq 1 60); do
  if curl -fsS -o /dev/null http://127.0.0.1/; then
    log "Juice Shop is up"
    exit 0
  fi
  sleep 5
done

log "Juice Shop did not answer within 5 minutes. Check: sudo podman logs juice-shop-app"
exit 1
