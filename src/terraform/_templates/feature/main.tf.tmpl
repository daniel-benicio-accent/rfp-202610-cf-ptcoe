# Fill in the rule body, then treat this as ordinary tracked code.
#
# THE TOGGLE PATTERN
# Every edge feature is off by default and switched on by its own variable.
# That is what lets a demo show the same request accepted before and refused
# after, without rebuilding the environment (spec 0001 FR-6). Keep `count` on
# every resource here so disabling the feature removes it cleanly.
#
# >>> PROVIDER VERSION NOTE <<<
# Written for Cloudflare provider v5, schema-validated against 5.28.1. v5
# restructured rulesets relative to v4: rules are a list of objects, not
# repeated blocks. v4 examples found online will not apply cleanly.
# =============================================================================

locals {
  enabled = var.__ENABLE_VAR__ ? 1 : 0
}

# Which phase a feature belongs in:
#
#   http_request_firewall_custom    custom allow/block/challenge rules
#   http_request_firewall_managed   Cloudflare managed WAF rulesets
#   http_ratelimit                  rate limiting rules
#   ddos_l7                         HTTP DDoS managed ruleset overrides
#   http_request_transform          URI/header rewrites, visitor-facing
#   http_request_late_transform     rewrites applied towards the origin
#
# A zone may hold only one ruleset per phase, so if two features need the same
# phase they must share one module rather than each declaring their own.
resource "cloudflare_ruleset" "this" {
  count = local.enabled

  zone_id = var.zone_id
  name    = "__FEATURE_SLUG__"
  kind    = "zone"
  phase   = var.phase

  rules = [{
    ref         = "__FEATURE_SLUG___rule"
    description = "__FEATURE_NAME__ (spec __SPEC_ID__)"

    # TODO(__SPEC_ID__): replace with the real match expression.
    # Scope it to the demo hostname so the rule cannot affect anything else in
    # the zone. Example shape:
    #   (http.host eq "demo.example.com" and <feature condition>)
    expression = var.expression

    action  = var.action
    enabled = true
  }]
}
